# ─── Azure OpenAI ─────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-model-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ─── Azure AD / Microsoft Graph ──────────────────────────────────
# The app registration MUST be marked "multi-tenant" in Azure AD if you want
# to connect additional tenants via the in-app "Connect tenant" button.
AZURE_TENANT_ID=your-primary-tenant-id
AZURE_CLIENT_ID=your-app-client-id

# Authenticate with EITHER a client secret OR a client certificate.
# Certificate auth is preferred for production. Set the path to a .pem or .pfx
# file; the file must contain the private key.
AZURE_CLIENT_SECRET=your-client-secret
# AZURE_CLIENT_CERT_PATH=./certs/intune007.pem
# AZURE_CLIENT_CERT_PASSWORD=

# ─── Server ──────────────────────────────────────────────────────
PORT=3001

# Public base URL — used to build the OAuth admin-consent redirect URI.
# In dev: http://localhost:3001 (default). In prod: your public HTTPS URL.
# This URL must be registered as a redirect URI on the app registration:
#   {APP_BASE_URL}/api/tenants/consent-callback
# APP_BASE_URL=http://localhost:3001

# ─── Multi-Tenant ────────────────────────────────────────────────
# Connected tenants are now stored in tenants.db (auto-created on first run)
# and managed through the UI. The legacy AZURE_TENANTS JSON env var is still
# imported on first launch for backward compatibility:
# AZURE_TENANTS=[{"tenantId":"...","label":"Second Tenant"}]
