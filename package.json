{
  "name": "intune-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent for querying Microsoft Intune via Microsoft Graph API",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm -w server run dev",
    "dev:client": "npm -w client run dev",
    "build": "npm -w shared run build && npm -w server run build && npm -w client run build",
    "build:server": "npm -w server run build",
    "build:client": "npm -w client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
